# Copy this file to .env and fill in the values. Never commit .env.

# --- Model provider -------------------------------------------------------
# Groq API key (free tier). Needed for benchmarks and for the guardrail.
GROQ_API_KEY=

# Models, in LiteLLM "provider/model" form. Groq retires models from time to
# time: run `mirrorguard models check` to see which of these still answer.
# MG_PERSONA_MODEL=groq/openai/gpt-oss-20b
# MG_JUDGE_MODEL=groq/openai/gpt-oss-120b
# MG_RISK_MODEL=groq/openai/gpt-oss-20b
# MG_REWRITER_MODEL=groq/openai/gpt-oss-120b
# MG_TARGET_MODELS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b,groq/llama-3.1-8b-instant

# Free-tier pacing. Lower these if you see many "rate limit" retries.
# MG_LLM_REQUESTS_PER_MINUTE=25
# MG_LLM_MAX_CONCURRENCY=4

# --- Storage --------------------------------------------------------------
# Default is a local SQLite file. Docker Compose sets these two for you.
# MG_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mirrorguard
# MG_REDIS_URL=redis://localhost:6379/0

# Used by docker-compose.yml only.
POSTGRES_PASSWORD=

# --- API ------------------------------------------------------------------
# Quick admin keys for local use, as key:tenant pairs separated by commas.
# In production create keys with `mirrorguard keys create` instead.
# MG_API_KEYS=local-dev-key:demo
# MG_TENANT_REQUESTS_PER_MINUTE=120
# MG_CORS_ORIGINS=http://localhost:3000
# MG_RETENTION_DAYS=90
